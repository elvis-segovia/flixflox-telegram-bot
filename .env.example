# Copiar a .env y completar. .env NO se commitea.

# Token del bot (BotFather).
BOT_TOKEN=

# IDs numéricos de Telegram autorizados, separados por coma.
# Vacío = cualquiera puede usar el bot (no recomendado).
ALLOWED_USER_IDS=265596142

# Credenciales de la app de Telegram (https://my.telegram.org) que usa el
# servidor Bot API local del docker-compose.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Opcionales (valores por defecto entre paréntesis) ---

# Carpeta final donde se guardan los archivos (./uploads)
# DOWNLOAD_DIR=./uploads

# Endpoints del Bot API local. Deben tener dos %s: token y ruta.
# TELEGRAM_API_ENDPOINT=http://localhost:8081/bot%s/%s
# TELEGRAM_FILE_ENDPOINT=http://localhost:8081/file/bot%s/%s

# Volumen del servidor local: ruta en el host y ruta dentro del contenedor.
# TELEGRAM_DATA_DIR=./telegram-data
# TELEGRAM_SERVER_WORK_DIR=/var/lib/telegram-bot-api

# Loguea cada request/response del Bot API (ojo: imprime el token).
# DEBUG=false
