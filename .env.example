# Copy to .env and fill in. .env is NOT committed.

# Bot token (from BotFather).
BOT_TOKEN=

# Authorized numeric Telegram IDs, comma separated.
# Empty = anyone can use the bot (not recommended).
ALLOWED_USER_IDS=265596142

# Credentials of the Telegram app (https://my.telegram.org) used by the local
# Bot API server from docker-compose.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# flixflox API: the genre list comes from there, and the item for every file
# uploaded is published there (POST /v1/api/bot/videos). Empty = not published.
FLIXFLOX_API_URL=

# --- Optional (default values in parentheses) ---

# Final folder where the files are stored (./uploads)
# DOWNLOAD_DIR=./uploads

# Local Bot API endpoints. They must have two %s: token and path.
# TELEGRAM_API_ENDPOINT=http://localhost:8081/bot%s/%s
# TELEGRAM_FILE_ENDPOINT=http://localhost:8081/file/bot%s/%s

# The local server's volume: path on the host and path inside the container.
# TELEGRAM_DATA_DIR=./telegram-data
# TELEGRAM_SERVER_WORK_DIR=/var/lib/telegram-bot-api

# Logs every Bot API request/response (careful: it prints the token).
# DEBUG=false
